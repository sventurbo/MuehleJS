# Settings of the Mühle server. To change one, copy this file and edit the copy:
#
#   cp .env.example .env
#
# `npm start` reads .env with Node's built-in --env-file-if-exists, so no extra
# package is needed and a missing .env is fine. A variable set in the shell
# (PORT=8080 npm start) wins over the file, and a port on the command line
# (npm start 8080) wins over both. .env is git-ignored; this file is not.
#
# Every setting is optional and commented out, so the default applies. Remove
# the leading "# " of a line to change it.

# Port the server listens on, over IPv6 and IPv4. Default: 3000.
# PORT=3000

# Reverse proxies whose X-Forwarded-For header may name the client for the
# login rate limit (README: "Betrieb hinter einem Reverse Proxy"). Default:
# unset, the header is ignored. Either a comma-separated list of addresses,
# CIDR ranges or the presets loopback, linklocal and uniquelocal, or the number
# of proxies directly in front of the server. "true" and invalid addresses stop
# the server at startup.
# TRUST_PROXY=loopback

# Time per decision in milliseconds (placing, moving, or picking the stone to
# capture). Default: 25000. Anything that is not a positive number falls back
# to the default, so the turn timer cannot be switched off by mistake.
# TURN_TIMEOUT_MS=60000

{
  "name": "muehle-web-spiel",
  "version": "1.0.0",
  "type": "module",
  "description": "Multiplayer Web-Spiel Mühle (Nine Men's Morris) mit HTML5, CSS3, JavaScript, Express und Socket.io",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "echo 'Build step completed (vanilla frontend, no bundle required)'",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --verbose",
    "contrast-check": "node scripts/contrast-check.js"
  },
  "keywords": [
    "muehle",
    "nine-mens-morris",
    "boardgame",
    "socketio",
    "express",
    "multiplayer",
    "ipv6",
    "ipv4"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "transform": {}
  }
}
